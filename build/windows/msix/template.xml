<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="proxy-switch"
        Arguments=""
        InstallLocation="C:\Program Files\Proxy Switch\Proxy Switch">
    </Installer>
    <PackageInformation
        PackageName="Proxy Switch"
        PackageDisplayName="Proxy Switch"
        PublisherName="CN=Proxy Switch"
        PublisherDisplayName="Proxy Switch"
        Version="0.1.0.0"
        PackageDescription="Proxy Switch">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.codexproviderhub.app"
                Description="Proxy Switch"
                DisplayName="Proxy Switch"
                ExecutableName="proxy-switch.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Proxy Switch</DisplayName>
            <PublisherDisplayName>Proxy Switch</PublisherDisplayName>
            <Description>Proxy Switch</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="proxy-switch.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
