{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" vite.config.ts",
    "lint": "eslint src vite.config.ts",
    "lint:staged": "lint-staged"
  },
  "dependencies": {
    "@wailsio/runtime": "^3.0.0-beta.27",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "prettier --write",
      "eslint --config eslint.config.js --fix"
    ],
    "src/**/*.{css,md}": [
      "prettier --write"
    ],
    "vite.config.ts": [
      "prettier --write",
      "eslint --config eslint.config.js --fix"
    ]
  }
}
